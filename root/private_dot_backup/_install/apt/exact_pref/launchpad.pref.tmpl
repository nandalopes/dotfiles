Package: inkscape:amd64
Pin: release o=LP-PPA-inkscape.dev-stable
Pin-Priority: {{ $pinPriority }}

Package: keepassxc:amd64
Pin: release o=LP-PPA-phoerious-keepassxc
Pin-Priority: {{ $pinPriority }}

Package: /obs/:any
Pin: release o=LP-PPA-obsproject-obs-studio
Pin-Priority: {{ $pinPriority }}

Package: /git/:amd64
Pin: release o=LP-PPA-git-core
Pin-Priority: 500

Package: *
Pin: release o=LP-PPA-flatpak-stable
Pin-Priority: 500

Package: *
Pin: release o=LP-PPA-kobuk-team-intel-graphics
Pin-Priority: 500

Package: {{ sortAlpha $libreofficeInstalled | join " " }}
Pin: release o=LP-PPA-libreoffice-libreoffice-still
Pin-Priority: 500

Package: {{ sortAlpha $ppaInstalled | join " " }}
Pin: origin ppa.launchpad*.net
Pin-Priority: 500

Package: *
Pin: origin ppa.launchpad*.net
Pin-Priority: 100
