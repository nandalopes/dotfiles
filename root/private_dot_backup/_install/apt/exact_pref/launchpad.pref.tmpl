{{- $pinPriority := 500 -}}
{{- if gt .chezmoi.osRelease.versionID "21.10" -}}
{{-   $pinPriority = 510 -}}
{{- end -}}
{{- $ppaInstalled := list
      "materia-kde:any"
      "papirus-icon*:any"
      "/kvantum/:amd64"
      "/solaar/"
      "sqlitebrowser:amd64"
      "texstudio"
      "xournalpp"
-}}
{{- $libreofficeInstalled := list
      "/libreoffice/"
      "/ure/"
      "fonts*"
      "gir*"
      "libofficebean*"
      "libuno*"
      "/python?-access2base/"
      "/python?-scriptforge/"
      "/python?-uno/"
      "uno-libs-private"
-}}
{{- $ppaPriority := list
      "keepassxc"
      "obs-studio"
-}}

#Package: *
#Pin: release o=LP-PPA-kdenlive-kdenlive-stable
