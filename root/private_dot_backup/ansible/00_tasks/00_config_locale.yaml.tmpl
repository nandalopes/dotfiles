# chezmoi:template:left-delimiter=[{ right-delimiter=}]
# vim:fileencoding=utf-8:ft=yaml.ansible:
- name: Ensure locales generated
  community.general.locale_gen:
    state: present
    name: '{{ item }}'
  loop:
    - "{{ locale_language }}"
    - "{{ locale_origin }}"
      [{- if gt .chezmoi.osRelease.versionID "22.04" }]
    - "{{ locale_time }}"
    - "{{ locale_time }}.{{ locale_encoding }}"
      [{- end }]
    - "{{ locale_origin }}.{{ locale_encoding }}"
    - "{{ locale_language }}.{{ locale_encoding }}"
  [{- if lt .chezmoi.osRelease.versionID "22.10" }]
- name: Enable C locale
  ansible.builtin.lineinfile:
    state: present
    path: "/etc/locale.gen"
    regexp: "^(# )?C([ .].*)"
    line: "C\\2"
  [{- end }]
- name: Rewrite locale.conf
  ansible.builtin.template:
    src: [{ joinPath .chezmoi.destDir ".backup/ansible" "templates/locale.j2" }]
    dest: /etc/locale.conf
    mode: '0644'
- name: Run update-locale
  ansible.builtin.command: update-locale --no-checks
