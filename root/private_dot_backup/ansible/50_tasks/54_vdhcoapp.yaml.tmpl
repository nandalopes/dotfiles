[{- $vdhcoapp := joinPath .chezmoi.destDir ".backup/_install/vdhcoapp/vdhcoapp" }]
[{- if stat $vdhcoapp }]
# [{ output "sha256sum" $vdhcoapp | trim }]
- name: 'Installing Video Download Helper companion app'
  become: false
  ansible.builtin.command:
    argv:
      - [{ $vdhcoapp }]
      - install

[{- end }]
